# Copy the BACKEND block to backend/.env and the FRONTEND block to frontend/.env. Never commit real keys.
# Everything is read in two places only: backend/app/config.py and frontend/src/config/env.js.

# ===== BACKEND (backend/.env) =====
# Free key from Google AI Studio. Leave empty to run in sample/demo mode without AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is out of quota, overloaded or retired
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash
# Optional fallback LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# CORS: your frontend URL(s), comma-separated (add the deployed URL here)
ALLOWED_ORIGINS=http://localhost:5173


# ===== FRONTEND (frontend/.env) =====
# Backend base URL, no trailing slash. Leave empty for the frontend-only sample demo.
VITE_API_BASE_URL=http://localhost:8000
